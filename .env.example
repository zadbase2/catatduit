# CatatDuit Environment Configuration Example

# Google AI Studio API Key (dapatkan gratis di https://aistudio.google.com/)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Local Server Port (Default: 3000)
PORT=3000

# Vercel Postgres / Neon Database URL
# Dapatkan langsung dari Vercel Dashboard -> Storage -> Postgres -> Quickstart (.env.local)
# Format: postgres://default:password@ep-host-pooler.region.postgres.vercel-storage.com:5432/verceldb?sslmode=require
POSTGRES_URL=
DATABASE_URL=
